# ============================================================
# cesium-sky .gitignore
# 대상: Python(데이터 수집/가공), FastAPI, Node/Express,
#       React, HTML/Jinja2 단일 페이지
# ============================================================

# ---------- 공통 (OS / 에디터) ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.backup
.bak
.roo
.mapbox_token
*.bin
# IDE / 에디터 설정 (팀 공유 시 필요하면 주석 해제)
# .vscode/
# .idea/
*.code-workspace

# ---------- 환경 변수 / 시크릿 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 로그 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Python (데이터 수집/가공, FastAPI)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
wheels/
*.egg

# 가상환경
venv/
.venv/
env/
ENV/

# 테스트 / 정적분석 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
verify-script/
# Jupyter
.ipynb_checkpoints/

# 로컬 데이터 캐시 (필요 시 주석 해제)
# .cache/
# .data/

# ============================================================
# Node.js / Express
# ============================================================
node_modules/
.pnp/
.pnp.js

# 빌드 산출물
dist/
build/
out/
.next/
.nuxt/
.parcel-cache/

# ============================================================
# Frontend (React / Vite / 일반 웹)
# ============================================================
# Vite
.vite/

# React
coverage/
*.tsbuildinfo

# ============================================================
# 데이터 (기상 원시 데이터 등 대용량 파일)
# 필요 시 주석 해제하여 무시 대상 확장
# ============================================================
kim_data
raw
# *.nc
# *.hdf5
# *.h5
# *.zip
# *.tar.gz
# *.parquet

# ============================================================
# verify-script (테스트 산출물)
# ============================================================
verify-script/shots/
